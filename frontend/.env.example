# The app calls its own origin by default (`/api/v1`), proxied to the backend by
# nginx in production and by the Vite dev server locally. Nothing to configure.
#
# Set VITE_API_URL only if you deploy the API on a SEPARATE domain, e.g.
# VITE_API_URL=https://api.lougasolidaire.org/api/v1

# Backend address used by the dev server proxy (npm run dev).
DEV_API_TARGET=http://localhost:3000
