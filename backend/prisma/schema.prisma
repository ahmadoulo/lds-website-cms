// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Authentication & RBAC
// -----------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  passwordHash       String
  firstName          String?
  lastName           String?
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  lastLoginAt        DateTime?

  role UserRole @default(EDITOR)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs AuditLog[]

  @@index([email])
}

// -----------------------------------------------------------------------------
// System Configuration & Layout
// -----------------------------------------------------------------------------

model SiteSettings {
  id    String @id @default(uuid())
  key   String @unique
  /// What the public site serves.
  value Json
  type  String // 'string', 'boolean', 'json', 'number'

  /// Pending edits, invisible to visitors until published. NULL means the
  /// published value is the current one and there is nothing awaiting review.
  draftValue     Json?
  draftUpdatedAt DateTime?
  publishedAt    DateTime?

  updatedAt DateTime @updatedAt
}

model NavigationItem {
  id       String           @id @default(uuid())
  label    Json // { "fr": "...", "en": "..." }
  href     String
  order    Int              @default(0)
  parentId String?
  parent   NavigationItem?  @relation("NavHierarchy", fields: [parentId], references: [id])
  children NavigationItem[] @relation("NavHierarchy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model SocialLink {
  id       String  @id @default(uuid())
  platform String // Facebook, Instagram, Twitter
  url      String
  icon     String // Icon class or identifier
  order    Int     @default(0)
  isActive Boolean @default(true)
}

// -----------------------------------------------------------------------------
// Media & Storage
// -----------------------------------------------------------------------------

model Media {
  id           String @id @default(uuid())
  originalName String
  storageKey   String @unique
  bucket       String
  folder       String @default("general")
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  altText      Json? // { "fr": "...", "en": "..." }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Reverse relations to entities using media
  missionsCover Mission[]      @relation("MissionCover")
  newsCover     News[]         @relation("NewsCover")
  partnerLogo   Partner[]      @relation("PartnerLogo")
  galleryImages GalleryImage[] @relation("GalleryMedia")
}

// -----------------------------------------------------------------------------
// Content Modules
// -----------------------------------------------------------------------------

model Mission {
  id          String  @id @default(uuid())
  title       Json // { "fr": "...", "en": "..." }
  description Json
  /// Optional long form shown when a visitor opens the domain. HTML, sanitised
  /// like a news body. NULL means the dialog shows the description alone.
  content     Json?
  icon        String? // e.g., lucide-react icon name
  order       Int     @default(0)
  isPublished Boolean @default(false)

  imageId String?
  image   Media?  @relation("MissionCover", fields: [imageId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsCategory {
  id   String @id @default(uuid())
  name Json // { "fr": "...", "en": "..." }
  slug String @unique
  news News[]
}

model News {
  id      String @id @default(uuid())
  title   Json
  slug    String @unique
  excerpt Json
  content Json // Rich text or block data

  categoryId String?
  category   NewsCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  imageId String?
  image   Media?  @relation("NewsCover", fields: [imageId], references: [id])

  isPublished Boolean   @default(false)
  /// When it becomes public. In the future, the article is scheduled: the
  /// public site does not show it until then.
  publishedAt DateTime?

  // ---------------------------------------------------------------- announcements
  // An announcement is an article with some of these set. Every one is
  // optional: an ordinary article leaves them all empty and is unchanged.

  /// The activity itself: when it happens, where, and what to know.
  eventStartsAt DateTime?
  eventEndsAt   DateTime?
  /// { fr, ar }
  location      Json?
  /// { fr, ar } - plain text: what to bring, who it is for, how to take part.
  practicalInfo Json?

  /// The window during which it appears in the banner and the "À venir"
  /// block. Outside it the article is still published and reachable; it just
  /// stops being pushed at visitors.
  visibleFrom  DateTime?
  visibleUntil DateTime?

  showInBanner   Boolean @default(false)
  /// The banner's one line, { fr, ar }. Defaults to the title.
  bannerText     Json?
  /// 'home' or 'all'.
  bannerScope    String  @default("home")
  /// The "À venir" block of the home page.
  showInUpcoming Boolean @default(false)
  /// Listed first wherever announcements are listed.
  isFeatured     Boolean @default(false)

  /// Archived: out of every list and the sitemap, but its address keeps
  /// working, because it was shared - a link in a WhatsApp group should not
  /// turn into a 404 the week after.
  archivedAt DateTime?

  /// [{ type, label?, url? }] - see news/announcement.ts.
  actions Json?
  /// A contact specific to this announcement: { name?, phone?, email? }.
  contact Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([publishedAt])
}

model GalleryAlbum {
  id          String  @id @default(uuid())
  title       Json
  description Json?
  order       Int     @default(0)
  isPublished Boolean @default(false)

  images GalleryImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryImage {
  id      String @id @default(uuid())
  caption Json?
  order   Int    @default(0)

  albumId String
  album   GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  mediaId String
  media   Media  @relation("GalleryMedia", fields: [mediaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([albumId])
}

model Partner {
  id          String  @id @default(uuid())
  name        String
  icon        String?
  url         String?
  order       Int     @default(0)
  isPublished Boolean @default(true)

  logoId String?
  logo   Media?  @relation("PartnerLogo", fields: [logoId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ImpactStatistic {
  id          String  @id @default(uuid())
  label       Json // { "fr": "...", "en": "..." }
  value       Int
  color       String // hex code for visual identity
  /// lucide-react icon name shown above the figure. NULL renders the number alone.
  icon        String?
  order       Int     @default(0)
  isPublished Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DonationMethod {
  id          String  @id @default(uuid())
  title       Json
  description Json
  actionType  String // 'phone', 'link', 'contact'
  actionData  String // e.g., "+221 77 861 32 02" or URL
  actionLabel Json
  iconColor   String // 'orange', 'blue', 'green'
  order       Int     @default(0)
  isPublished Boolean @default(true)

  /// Mobile money or bank provider, when this method is one: 'wave',
  /// 'orange_money', 'bank', 'cash', 'other'. NULL keeps the generic behaviour.
  provider    String?
  /// Account holder, shown so a donor can confirm before sending.
  beneficiary String?
  /// Official payment link, when the association actually has one. No deep link
  /// is ever fabricated: without this the site falls back to showing the number.
  paymentLink String?
}

model ContactMessage {
  id      String    @id @default(uuid())
  name    String
  email   String
  subject String
  message String    @db.Text
  isRead  Boolean   @default(false)
  readAt  DateTime?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([isRead])
}

// -----------------------------------------------------------------------------
// Audit
// -----------------------------------------------------------------------------

model AuditLog {
  id         String  @id @default(uuid())
  action     String // CREATE, UPDATE, DELETE, LOGIN
  resource   String // User, Mission, News, etc
  resourceId String?
  metadata   Json? // Detailed diff or snapshot

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([resource, resourceId])
  @@index([userId])
}

// -----------------------------------------------------------------------------
// Email
// -----------------------------------------------------------------------------

/// SMTP configuration and the identities the site sends under. One row.
///
/// Deliberately not a SiteSettings key: that table is returned whole by
/// GET /public/settings to anonymous visitors, so an SMTP host, a username and
/// the inbox the contact form lands in would all have been published.
model EmailSettings {
  id String @id @default("default")

  /// Outgoing mail off by default: nothing is sent until it is configured,
  /// tested and switched on deliberately.
  enabled Boolean @default(false)

  host           String?
  port           Int?
  /// 'tls' for implicit TLS (usually 465), 'starttls' (usually 587), or 'none'.
  security       String  @default("starttls")
  username       String?
  /// AES-256-GCM, keyed by EMAIL_ENCRYPTION_KEY. Never leaves the API, in any
  /// response, log or error message.
  passwordCipher String?

  /// The default identity. Per-purpose overrides live in `identities`.
  fromName     String?
  fromEmail    String?
  replyToName  String?
  replyToEmail String?

  /// Where a contact request lands, and where the system reports its own
  /// failures. Separate, because they are read by different people.
  contactInbox String?
  adminInbox   String?

  /// { contact: { fromName, fromEmail, replyToEmail }, newsletter: {...} }
  /// A single mailbox, several identities: the provider decides what it will
  /// accept as the envelope sender, so these change the display name and the
  /// Reply-To rather than the authenticated address.
  identities Json?

  /// How hard the worker is allowed to push a provider.
  batchSize     Int @default(20)
  ratePerMinute Int @default(60)

  /// The public address written into every email: links, logo, unsubscribe.
  /// Stored rather than read from each request, because the request that
  /// triggers a contact acknowledgement is an anonymous visitor's, and its
  /// Host / X-Forwarded-Host headers are theirs to forge - which would put
  /// their domain into a genuine email sent from this server.
  siteUrl          String?
  /// Appended to campaigns. { fr, ar }.
  signature        Json?
  /// Linked from the newsletter consent. Supplied by the association, never
  /// written by the application.
  privacyPolicyUrl String?

  lastTestAt    DateTime?
  lastTestOk    Boolean?
  /// Redacted before it is stored: a provider error can quote credentials.
  lastTestError String?

  updatedAt DateTime @updatedAt
}

enum EmailStatus {
  PENDING
  SENDING
  /// Accepted by the SMTP server. Not the same thing as delivered, and the
  /// interface never says otherwise.
  SENT
  /// Permanent: a bad address, a rejected sender, attempts exhausted.
  FAILED
  CANCELLED
}

/// The send queue and the history, in one table.
///
/// PostgreSQL rather than Redis: the deployment has no queue and adding a
/// container to run one would be the heaviest part of this feature. A row per
/// recipient claimed with FOR UPDATE SKIP LOCKED gives safe concurrent
/// workers, survives a restart by construction, and leaves the history already
/// written - which a separate queue would have had to duplicate anyway.
model EmailMessage {
  id String @id @default(uuid())

  /// 'contact_ack' | 'contact_notify' | 'test' | and later the newsletter ones.
  kind String

  toEmail String
  toName  String?

  fromName  String
  fromEmail String
  replyTo   String?

  subject String
  html    String @db.Text
  text    String @db.Text
  locale  String @default("fr")

  status        EmailStatus @default(PENDING)
  attempts      Int         @default(0)
  /// The earliest a worker may try again. Backoff moves it forward.
  nextAttemptAt DateTime    @default(now())
  /// Set while a worker holds the row; a stale value releases a crashed claim.
  lockedAt      DateTime?

  /// Redacted, and never the credentials.
  error String? @db.Text

  /// What caused this message, for the history and for not sending twice.
  contactMessageId String?
  campaignId       String?
  subscriberId     String?

  /// Extra headers, e.g. List-Unsubscribe for newsletters.
  headers Json?

  /// When the SMTP server accepted it.
  sentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Exactly one acknowledgement per contact request, whatever a retried POST
  /// or a double-clicked button does. NULLs do not collide in PostgreSQL, so
  /// this constrains only the messages that have a cause.
  @@unique([contactMessageId, kind])
  /// One copy of a campaign per subscriber, whatever happens to the sender.
  @@unique([campaignId, subscriberId])
  @@index([campaignId])
  @@index([status, nextAttemptAt])
  @@index([createdAt])
  @@index([kind])
}

/// The text of every email the system sends, editable without a deploy.
model EmailTemplate {
  id String @id @default(uuid())

  /// The stable name the code asks for: 'contact_ack', 'contact_notify', 'test'.
  key  String @unique
  name String

  /// { fr, ar } like every other editorial column in this schema.
  subject Json
  html    Json
  text    Json

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// Newsletter
// -----------------------------------------------------------------------------

enum SubscriberStatus {
  /// Asked to subscribe, has not clicked the confirmation link. Receives nothing.
  PENDING
  /// Confirmed. The only status a campaign is ever sent to.
  ACTIVE
  UNSUBSCRIBED
}

/// Someone who asked for the newsletter. Not a contact: writing to the
/// association is not consent to its newsletter, and nothing creates a row
/// here except an explicit, confirmed request (or an attested import).
model NewsletterSubscriber {
  id     String           @id @default(uuid())
  email  String           @unique
  status SubscriberStatus @default(PENDING)
  locale String           @default("fr")
  /// 'footer', 'page', 'popup', 'import'.
  source String           @default("footer")

  /// The consent, as given: when, and the exact sentence that was agreed to.
  consentAt   DateTime?
  consentText String?

  /// SHA-256 of the confirmation token. The token itself exists only in the
  /// email; a database dump cannot be used to confirm anyone.
  confirmTokenHash      String?   @unique
  confirmTokenExpiresAt DateTime?
  confirmSentAt         DateTime?
  confirmedAt           DateTime?

  unsubscribedAt         DateTime?
  /// Which campaign's link was used, for that campaign's statistics.
  unsubscribedCampaignId String?

  lastCampaignAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// Campaigns
// -----------------------------------------------------------------------------

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  PAUSED
  SENT
  CANCELLED
}

model Campaign {
  id   String @id @default(uuid())
  /// For the team only; never shown to a recipient.
  name String

  subject   String
  /// The line inbox lists show after the subject.
  preheader String?
  /// The content, as editor blocks. Rendered to email HTML by the server, so
  /// nothing typed in the editor can reach a recipient as markup.
  blocks    Json
  /// One language per campaign: an Arabic campaign goes to Arabic readers.
  locale    String  @default("fr")
  /// { segment: 'all' | 'fr' | 'ar' | 'period', from?, to? }
  audience  Json

  fromName         String?
  replyTo          String?
  includeSignature Boolean @default(true)

  status         CampaignStatus @default(DRAFT)
  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  /// The site address at the moment of sending, so a campaign that fires
  /// later from the scheduler links where the administrator meant.
  siteUrl        String?
  recipientCount Int?

  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledAt])
}
