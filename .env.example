# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lds_db
# In Docker, this is overridden in docker-compose.yml to point to postgres:5432
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?schema=public"

# MinIO
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=SuperSecretPassword123!
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=SuperSecretPassword123!
MINIO_BUCKET=lds-media

# JWT Auth (Change these in production)
JWT_SECRET=super_secret_jwt_key_example
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_example

# Initial Super Admin Seed (for first time setup)
ADMIN_SEED_EMAIL=admin@lougasolidaire.org
ADMIN_SEED_PASSWORD=Password123!

# Application URLs (Used for CORS and Frontend API connection)
API_URL=http://localhost:3000/api/v1
FRONTEND_URL=http://localhost:80
