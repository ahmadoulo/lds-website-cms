# =============================================================================
#  Louga Développement Solidaire — configuration
#
#  Run `./scripts/setup-env.sh` to generate this file with strong secrets.
#  Everything below has a working default except the four secrets, which the
#  script fills in for you.
# =============================================================================

# ------------------------------------------------------------------ exposure
# The only port published to the internet. The site AND the API are served from
# it: nginx forwards /api to the backend over the private Docker network.
SITE_PORT=8096

# ------------------------------------------------------------------ database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=lds_db
# Local development only. Inside Docker this is built from the values above.
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/lds_db?schema=public"

# ------------------------------------------------------------ object storage
# MinIO is never exposed publicly: images are streamed through the API.
MINIO_ROOT_USER=lds-storage
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=lds-media
# Local development only (inside Docker the API reaches MinIO at minio:9000).
MINIO_ENDPOINT=localhost
MINIO_PORT=9010
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=lds-storage
MINIO_SECRET_KEY=

# ---------------------------------------------------------------------- auth
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=7d

# First super administrator. Created once; a password change is forced at first
# login. Re-running the seed never creates a second account.
ADMIN_SEED_EMAIL=admin@lougasolidaire.org
ADMIN_SEED_PASSWORD=
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=LDS

# =============================================================================
#  Advanced — leave empty unless you know you need it
# =============================================================================
#
# By default the site and the API share one origin, so there is no URL to
# configure: the browser calls /api/v1 and nginx proxies it to the backend.
#
# Set the three below ONLY to serve the API from a separate domain, e.g.
#   VITE_API_URL=https://api.lougasolidaire.org/api/v1
#   PUBLIC_API_URL=https://api.lougasolidaire.org
#   CORS_ORIGIN=https://lougasolidaire.org
VITE_API_URL=
PUBLIC_API_URL=
CORS_ORIGIN=

# Number of reverse proxies in front of the API. 1 = the bundled nginx.
# Raise it if you put Traefik, Cloudflare or another proxy in front.
TRUST_PROXY_HOPS=1
